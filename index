<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interactive Quiz Application</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    :root {
      --primary-color: #dc2626;
      --primary-hover: #b91c1c;
      --accent-color: #1f2937;
    }
    .custom-btn-primary {
      background-color: var(--primary-color);
      color: white;
    }
    .custom-btn-primary:hover {
      background-color: var(--primary-hover);
    }
    .custom-border-primary {
      border-color: var(--primary-color);
    }
    .custom-text-primary {
      color: var(--primary-color);
    }
    .custom-bg-primary-light {
      background-color: color-mix(in srgb, var(--primary-color) 10%, transparent);
    }
  </style>
</head>
<body class="bg-gray-50 text-gray-800 min-h-screen font-sans antialiased pb-12">

  <div id="app" class="max-w-4xl mx-auto px-4 py-8">
    <!-- Navigation / Header -->
    <header class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-8 bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
      <div class="flex items-center gap-3">
        <div id="brand-badge" class="w-10 h-10 rounded-xl flex items-center justify-center text-white font-bold text-xl shadow-md" style="background-color: var(--primary-color);">
          Q
        </div>
        <div>
          <h1 id="app-title-display" class="font-bold text-gray-900 text-lg sm:text-xl">Interactive Quiz</h1>
          <p id="app-subtitle-display" class="text-xs text-gray-500">Test your knowledge or build your own quiz</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button id="nav-take-btn" onclick="switchView('take')" class="px-4 py-2 rounded-xl text-sm font-medium transition flex items-center gap-2 custom-btn-primary">
          <i data-lucide="play" class="w-4 h-4"></i> Take Quiz
        </button>
        <button id="nav-builder-btn" onclick="switchView('builder')" class="px-4 py-2 rounded-xl text-sm font-medium bg-gray-100 hover:bg-gray-200 text-gray-700 transition flex items-center gap-2">
          <i data-lucide="edit-3" class="w-4 h-4"></i> Quiz Builder
        </button>
      </div>
    </header>

    <!-- VIEW: TAKE QUIZ -->
    <main id="view-take" class="space-y-6">
      <!-- Quiz Progress Bar & Header -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 space-y-4">
        <div class="flex items-center justify-between text-sm font-medium text-gray-500">
          <span id="quiz-progress-text">Question 1 of 5</span>
          <span id="quiz-score-live" class="font-semibold custom-text-primary">Score: 0</span>
        </div>
        <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden">
          <div id="quiz-progress-bar" class="h-full transition-all duration-300 rounded-full" style="width: 20%; background-color: var(--primary-color);"></div>
        </div>
      </div>

      <!-- Question Card -->
      <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-100 space-y-6">
        <!-- Question Image Container -->
        <div id="question-image-container" class="hidden rounded-xl overflow-hidden max-h-80 border border-gray-100">
          <img id="question-image-element" src="" alt="Question Image" class="w-full h-full object-cover">
        </div>

        <h2 id="question-text-display" class="text-xl sm:text-2xl font-bold text-gray-900 leading-tight">
          Loading Question...
        </h2>

        <div id="options-container" class="grid gap-3">
          <!-- Options dynamically rendered here -->
        </div>

        <div id="feedback-box" class="hidden p-4 rounded-xl text-sm font-medium flex items-start gap-3">
          <i id="feedback-icon" data-lucide="info" class="w-5 h-5 flex-shrink-0 mt-0.5"></i>
          <span id="feedback-text"></span>
        </div>

        <div class="flex justify-end pt-4">
          <button id="next-btn" onclick="nextQuestion()" disabled class="px-6 py-3 rounded-xl font-semibold text-white transition flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed custom-btn-primary">
            Next Question <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
        </div>
      </div>
    </main>

    <!-- VIEW: QUIZ RESULTS -->
    <section id="view-results" class="hidden bg-white rounded-2xl p-8 shadow-sm border border-gray-100 text-center space-y-6">
      <div class="w-20 h-20 rounded-full flex items-center justify-center mx-auto custom-bg-primary-light">
        <i data-lucide="trophy" class="w-10 h-10 custom-text-primary"></i>
      </div>
      
      <div class="space-y-2">
        <h2 class="text-3xl font-extrabold text-gray-900">Quiz Completed!</h2>
        <p class="text-gray-500 text-sm">Here is how you performed:</p>
      </div>

      <div class="py-4">
        <div class="text-5xl font-black custom-text-primary" id="final-score-text">0 / 0</div>
        <p class="text-sm font-medium text-gray-500 mt-2" id="final-percentage-text">0%</p>
      </div>

      <div class="flex justify-center gap-4">
        <button onclick="restartQuiz()" class="px-6 py-3 rounded-xl font-semibold text-white transition flex items-center gap-2 custom-btn-primary">
          <i data-lucide="rotate-ccw" class="w-4 h-4"></i> Retake Quiz
        </button>
      </div>
    </section>

    <!-- VIEW: BUILDER -->
    <section id="view-builder" class="hidden space-y-8">
      <!-- Export / Import Control Bar -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 space-y-4">
        <h2 class="text-xl font-bold text-gray-900 border-b border-gray-100 pb-3 flex items-center gap-2">
          <i data-lucide="download" class="w-5 h-5 custom-text-primary"></i> Export & Save Quiz
        </h2>
        <p class="text-xs text-gray-500">Export your custom quiz data so you can save it, back it up, or load it anytime.</p>

        <div class="flex flex-wrap gap-3 pt-2">
          <button onclick="exportQuizJSON()" class="px-4 py-2.5 rounded-xl font-semibold text-sm text-white transition flex items-center gap-2 custom-btn-primary">
            <i data-lucide="file-output" class="w-4 h-4"></i> Export JSON File
          </button>
          
          <label class="px-4 py-2.5 rounded-xl font-semibold text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 transition flex items-center gap-2 cursor-pointer">
            <i data-lucide="file-input" class="w-4 h-4"></i> Import JSON File
            <input type="file" id="import-json-input" accept=".json" onchange="importQuizJSON(event)" class="hidden">
          </label>

          <button onclick="copyQuizCode()" class="px-4 py-2.5 rounded-xl font-semibold text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 transition flex items-center gap-2">
            <i data-lucide="copy" class="w-4 h-4"></i> Copy Quiz Data (Code)
          </button>
        </div>
      </div>

      <!-- General Settings -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 space-y-6">
        <h2 class="text-xl font-bold text-gray-900 border-b border-gray-100 pb-4 flex items-center gap-2">
          <i data-lucide="settings" class="w-5 h-5 custom-text-primary"></i> Quiz & Appearance Settings
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Quiz Title</label>
            <input type="text" id="builder-title" oninput="updateQuizMeta()" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-red-500 text-sm" placeholder="e.g. Community Knowledge Quiz">
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Subtitle / Description</label>
            <input type="text" id="builder-subtitle" oninput="updateQuizMeta()" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-red-500 text-sm" placeholder="e.g. Test how much you know about our mission">
          </div>
        </div>

        <!-- Color Preset Selector -->
        <div>
          <label class="block text-xs font-semibold text-gray-600 uppercase mb-2">Color Theme Palette</label>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
            <button onclick="applyColorTheme('#dc2626', '#b91c1c')" class="p-3 rounded-xl border border-gray-200 flex flex-col items-center gap-2 hover:border-red-500 transition">
              <span class="w-6 h-6 rounded-full bg-red-600 shadow-sm"></span>
              <span class="text-xs font-medium text-gray-700">Hub Red</span>
            </button>
            <button onclick="applyColorTheme('#4f46e5', '#4338ca')" class="p-3 rounded-xl border border-gray-200 flex flex-col items-center gap-2 hover:border-indigo-500 transition">
              <span class="w-6 h-6 rounded-full bg-indigo-600 shadow-sm"></span>
              <span class="text-xs font-medium text-gray-700">Indigo</span>
            </button>
            <button onclick="applyColorTheme('#059669', '#047857')" class="p-3 rounded-xl border border-gray-200 flex flex-col items-center gap-2 hover:border-emerald-500 transition">
              <span class="w-6 h-6 rounded-full bg-emerald-600 shadow-sm"></span>
              <span class="text-xs font-medium text-gray-700">Emerald</span>
            </button>
            <button onclick="applyColorTheme('#2563eb', '#1d4ed8')" class="p-3 rounded-xl border border-gray-200 flex flex-col items-center gap-2 hover:border-blue-500 transition">
              <span class="w-6 h-6 rounded-full bg-blue-600 shadow-sm"></span>
              <span class="text-xs font-medium text-gray-700">Ocean Blue</span>
            </button>
            <button onclick="applyColorTheme('#d97706', '#b45309')" class="p-3 rounded-xl border border-gray-200 flex flex-col items-center gap-2 hover:border-amber-500 transition">
              <span class="w-6 h-6 rounded-full bg-amber-600 shadow-sm"></span>
              <span class="text-xs font-medium text-gray-700">Amber</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Question List Editor -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
            <i data-lucide="list-checks" class="w-5 h-5 custom-text-primary"></i> Questions
          </h2>
          <button onclick="addQuestion()" class="px-4 py-2 rounded-xl text-sm font-semibold text-white transition flex items-center gap-2 custom-btn-primary">
            <i data-lucide="plus" class="w-4 h-4"></i> Add Question
          </button>
        </div>

        <div id="questions-builder-list" class="space-y-6">
          <!-- Dynamically populated question builder cards -->
        </div>
      </div>
    </section>
  </div>

  <script>
    // Initial Quiz State
    let quizData = {
      title: "Lancaster Community Quiz",
      subtitle: "Test your knowledge about our programs & impact",
      primaryColor: "#dc2626",
      primaryHover: "#b91c1c",
      questions: [
        {
          id: 1,
          question: "What is the primary mission of our Food Farmacy program?",
          image: "https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=800&q=80",
          options: [
            "Providing fresh produce & healthy nutritional support to families in need",
            "Hosting fast-food cooking events",
            "Selling organic vegetables to local grocery stores",
            "Teaching gardening classes for commercial farms"
          ],
          correct: 0,
          explanation: "The Food Farmacy provides nutritious food and health resources to local community members!"
        },
        {
          id: 2,
          question: "How can volunteers get involved in supporting the community hub?",
          image: "",
          options: [
            "By donating clothing and fresh food items",
            "By helping pack and distribute food boxes",
            "By offering time to support outreach programs",
            "All of the above"
          ],
          correct: 3,
          explanation: "Volunteers support us through donations, food packing, and active program participation!"
        }
      ]
    };

    let currentQuestionIndex = 0;
    let score = 0;
    let selectedOption = null;

    // Load saved quiz from localStorage if available
    document.addEventListener("DOMContentLoaded", () => {
      const saved = localStorage.getItem("custom_quiz_data");
      if (saved) {
        try { quizData = JSON.parse(saved); } catch(e){}
      }
      lucide.createIcons();
      applyColorTheme(quizData.primaryColor, quizData.primaryHover);
      renderTakeQuiz();
      renderBuilder();
    });

    function saveToLocalStorage() {
      localStorage.setItem("custom_quiz_data", JSON.stringify(quizData));
    }

    // Theme Switcher
    function applyColorTheme(primary, hover) {
      quizData.primaryColor = primary;
      quizData.primaryHover = hover;
      document.documentElement.style.setProperty('--primary-color', primary);
      document.documentElement.style.setProperty('--primary-hover', hover);
      saveToLocalStorage();
    }

    // Export & Import Functions
    function exportQuizJSON() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(quizData, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `${quizData.title.toLowerCase().replace(/\s+/g, '_')}_quiz.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    }

    function importQuizJSON(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const imported = JSON.parse(e.target.result);
          if (imported.title && Array.isArray(imported.questions)) {
            quizData = imported;
            applyColorTheme(quizData.primaryColor || "#dc2626", quizData.primaryHover || "#b91c1c");
            saveToLocalStorage();
            renderTakeQuiz();
            renderBuilder();
            alert("Quiz loaded successfully!");
          } else {
            alert("Invalid quiz JSON file structure.");
          }
        } catch(err) {
          alert("Error parsing JSON file.");
        }
      };
      reader.readAsText(file);
    }

    function copyQuizCode() {
      const code = JSON.stringify(quizData, null, 2);
      navigator.clipboard.writeText(code).then(() => {
        alert("Quiz configuration copied to clipboard!");
      });
    }

    // View Navigation
    function switchView(view) {
      const takeView = document.getElementById("view-take");
      const resultsView = document.getElementById("view-results");
      const builderView = document.getElementById("view-builder");

      const takeBtn = document.getElementById("nav-take-btn");
      const builderBtn = document.getElementById("nav-builder-btn");

      takeView.classList.add("hidden");
      resultsView.classList.add("hidden");
      builderView.classList.add("hidden");

      if (view === "take") {
        takeView.classList.remove("hidden");
        takeBtn.className = "px-4 py-2 rounded-xl text-sm font-medium transition flex items-center gap-2 custom-btn-primary";
        builderBtn.className = "px-4 py-2 rounded-xl text-sm font-medium bg-gray-100 hover:bg-gray-200 text-gray-700 transition flex items-center gap-2";
        renderTakeQuiz();
      } else if (view === "builder") {
        builderView.classList.remove("hidden");
        builderBtn.className = "px-4 py-2 rounded-xl text-sm font-medium transition flex items-center gap-2 custom-btn-primary";
        takeBtn.className = "px-4 py-2 rounded-xl text-sm font-medium bg-gray-100 hover:bg-gray-200 text-gray-700 transition flex items-center gap-2";
        renderBuilder();
      }
    }

    // Quiz Runner Render
    function renderTakeQuiz() {
      const q = quizData.questions[currentQuestionIndex];
      if (!q) return;

      document.getElementById("app-title-display").innerText = quizData.title;
      document.getElementById("app-subtitle-display").innerText = quizData.subtitle;

      document.getElementById("quiz-progress-text").innerText = `Question ${currentQuestionIndex + 1} of ${quizData.questions.length}`;
      document.getElementById("quiz-progress-bar").style.width = `${((currentQuestionIndex + 1) / quizData.questions.length) * 100}%`;
      document.getElementById("quiz-score-live").innerText = `Score: ${score}`;

      // Question Image
      const imgContainer = document.getElementById("question-image-container");
      const imgElem = document.getElementById("question-image-element");
      if (q.image && q.image.trim() !== "") {
        imgElem.src = q.image;
        imgContainer.classList.remove("hidden");
      } else {
        imgContainer.classList.add("hidden");
      }

      document.getElementById("question-text-display").innerText = q.question;

      // Reset Feedback & Next Button
      const feedbackBox = document.getElementById("feedback-box");
      feedbackBox.classList.add("hidden");
      document.getElementById("next-btn").disabled = true;

      // Render Options
      const container = document.getElementById("options-container");
      container.innerHTML = "";
      selectedOption = null;

      q.options.forEach((opt, idx) => {
        const btn = document.createElement("button");
        btn.className = "w-full text-left p-4 rounded-xl border border-gray-200 hover:border-gray-300 bg-white font-medium text-gray-800 transition flex items-center justify-between group";
        btn.onclick = () => selectOption(idx);
        btn.id = `opt-btn-${idx}`;
        btn.innerHTML = `
          <span>${opt}</span>
          <span class="w-5 h-5 rounded-full border border-gray-300 flex items-center justify-center group-hover:border-gray-400">
            <span class="w-2.5 h-2.5 rounded-full bg-transparent"></span>
          </span>
        `;
        container.appendChild(btn);
      });
    }

    function selectOption(idx) {
      const q = quizData.questions[currentQuestionIndex];
      if (selectedOption !== null) return;
      selectedOption = idx;

      const isCorrect = idx === q.correct;
      if (isCorrect) score++;

      q.options.forEach((_, i) => {
        const btn = document.getElementById(`opt-btn-${i}`);
        btn.disabled = true;
        if (i === q.correct) {
          btn.className = "w-full text-left p-4 rounded-xl border-2 border-emerald-500 bg-emerald-50 text-emerald-900 font-semibold flex items-center justify-between";
        } else if (i === idx && !isCorrect) {
          btn.className = "w-full text-left p-4 rounded-xl border-2 border-red-500 bg-red-50 text-red-900 font-semibold flex items-center justify-between";
        } else {
          btn.className = "w-full text-left p-4 rounded-xl border border-gray-200 bg-gray-50 text-gray-400 opacity-60 flex items-center justify-between";
        }
      });

      const feedbackBox = document.getElementById("feedback-box");
      const feedbackText = document.getElementById("feedback-text");
      feedbackBox.classList.remove("hidden");

      if (isCorrect) {
        feedbackBox.className = "p-4 rounded-xl text-sm font-medium flex items-start gap-3 bg-emerald-50 text-emerald-800 border border-emerald-200";
        feedbackText.innerText = `Correct! ${q.explanation || ''}`;
      } else {
        feedbackBox.className = "p-4 rounded-xl text-sm font-medium flex items-start gap-3 bg-red-50 text-red-800 border border-red-200";
        feedbackText.innerText = `Incorrect. ${q.explanation || ''}`;
      }

      document.getElementById("next-btn").disabled = false;
      document.getElementById("quiz-score-live").innerText = `Score: ${score}`;
    }

    function nextQuestion() {
      if (currentQuestionIndex < quizData.questions.length - 1) {
        currentQuestionIndex++;
        renderTakeQuiz();
      } else {
        showResults();
      }
    }

    function showResults() {
      document.getElementById("view-take").classList.add("hidden");
      document.getElementById("view-results").classList.remove("hidden");

      const total = quizData.questions.length;
      const pct = Math.round((score / total) * 100);

      document.getElementById("final-score-text").innerText = `${score} / ${total}`;
      document.getElementById("final-percentage-text").innerText = `${pct}% Correct`;

      if (pct >= 70 && typeof confetti === "function") {
        confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
      }
    }

    function restartQuiz() {
      currentQuestionIndex = 0;
      score = 0;
      document.getElementById("view-results").classList.add("hidden");
      document.getElementById("view-take").classList.remove("hidden");
      renderTakeQuiz();
    }

    // Builder Render
    function renderBuilder() {
      document.getElementById("builder-title").value = quizData.title;
      document.getElementById("builder-subtitle").value = quizData.subtitle;

      const container = document.getElementById("questions-builder-list");
      container.innerHTML = "";

      quizData.questions.forEach((q, qIndex) => {
        const card = document.createElement("div");
        card.className = "bg-white p-6 rounded-2xl border border-gray-100 shadow-sm space-y-4";
        card.innerHTML = `
          <div class="flex items-center justify-between border-b border-gray-100 pb-3">
            <span class="font-bold text-gray-700 text-sm">Question #${qIndex + 1}</span>
            <button onclick="removeQuestion(${qIndex})" class="text-red-500 hover:text-red-700 text-xs font-semibold flex items-center gap-1">
              <i data-lucide="trash-2" class="w-4 h-4"></i> Delete
            </button>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Question Prompt</label>
            <input type="text" value="${q.question}" oninput="updateQuestionText(${qIndex}, this.value)" class="w-full px-4 py-2 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-red-500 focus:outline-none">
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Image URL (Optional)</label>
            <input type="text" value="${q.image || ''}" oninput="updateQuestionImage(${qIndex}, this.value)" placeholder="https://example.com/image.jpg" class="w-full px-4 py-2 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-red-500 focus:outline-none">
          </div>

          <div class="space-y-2">
            <label class="block text-xs font-semibold text-gray-600 uppercase">Answer Options (Select correct radio)</label>
            ${q.options.map((opt, oIndex) => `
              <div class="flex items-center gap-2">
                <input type="radio" name="correct-${qIndex}" ${q.correct === oIndex ? 'checked' : ''} onchange="setCorrectAnswer(${qIndex},${oIndex})" class="w-4 h-4 text-red-600 focus:ring-red-500">
                <input type="text" value="${opt}" oninput="updateOptionText(${qIndex},${oIndex}, this.value)" class="w-full px-3 py-1.5 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-red-500">
              </div>
            `).join('')}
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Explanation (Optional)</label>
            <input type="text" value="${q.explanation || ''}" oninput="updateExplanation(${qIndex}, this.value)" class="w-full px-4 py-2 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-red-500 focus:outline-none" placeholder="Shown after user answers">
          </div>
        `;
        container.appendChild(card);
      });

      lucide.createIcons();
    }

    function updateQuizMeta() {
      quizData.title = document.getElementById("builder-title").value;
      quizData.subtitle = document.getElementById("builder-subtitle").value;
      saveToLocalStorage();
    }

    function addQuestion() {
      quizData.questions.push({
        id: Date.now(),
        question: "New Question",
        image: "",
        options: ["Option 1", "Option 2", "Option 3", "Option 4"],
        correct: 0,
        explanation: ""
      });
      saveToLocalStorage();
      renderBuilder();
    }

    function removeQuestion(index) {
      if (quizData.questions.length <= 1) {
        alert("Your quiz must have at least one question!");
        return;
      }
      quizData.questions.splice(index, 1);
      saveToLocalStorage();
      renderBuilder();
    }

    function updateQuestionText(qIndex, val) { quizData.questions[qIndex].question = val; saveToLocalStorage(); }
    function updateQuestionImage(qIndex, val) { quizData.questions[qIndex].image = val; saveToLocalStorage(); }
    function setCorrectAnswer(qIndex, oIndex) { quizData.questions[qIndex].correct = oIndex; saveToLocalStorage(); }
    function updateOptionText(qIndex, oIndex, val) { quizData.questions[qIndex].options[oIndex] = val; saveToLocalStorage(); }
    function updateExplanation(qIndex, val) { quizData.questions[qIndex].explanation = val; saveToLocalStorage(); }
  </script>
